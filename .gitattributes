# 统一换行符：仓库内一律 LF，避免 Windows/Linux 之间产生无意义的整文件 diff
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
LICENSE text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.mat   binary
*.npy   binary
*.npz   binary
*.pth   binary
*.pt    binary

# 让 GitHub 把 .ipynb 当作代码统计
*.ipynb linguist-detectable=true
